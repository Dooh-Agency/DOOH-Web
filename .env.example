# URL pública del proyecto Supabase para el planificador interno.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key de Supabase. Es segura para exponer en el navegador
# cuando las políticas RLS de supabase/migrations estén aplicadas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública usada por los enlaces de acceso por email.
# En producción: https://www.dooh.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto (Cloudflare Pages Function + Resend).
# Configurarlas como secretos de producción y preview en Cloudflare; no usar
# valores reales en este archivo ni exponer RESEND_API_KEY al navegador.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_RECIPIENT=
ALLOWED_CONTACT_ORIGIN=
