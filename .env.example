# URL pública del sitio. En producción: https://www.dooh.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto (Cloudflare Pages Function + Resend).
# Configurarlas como secretos de producción y preview en Cloudflare; no usar
# valores reales en este archivo ni exponer RESEND_API_KEY al navegador.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_RECIPIENT=
ALLOWED_CONTACT_ORIGIN=

# El planificador de redes no usa variables locales: sus claves se cargan en
# Cloudflare Pages (ver automation/google-sheet-sync/SETUP.md), incluido el
# secreto opcional INSTAGRAM_ACCESS_TOKEN para mostrar los posts publicados.
